# Which AI maps prompts to simulations: ollama | gemini | (blank = no AI, manual picker only)
AI_PROVIDER=ollama

# Local Ollama (free, offline). Pull the model first: ollama pull llama3.2:3b  (~2 GB)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional: a different model for experimental mode (AI writes new simulations).
# Blank = same as above. A coding model writes better code but must fit your GPU to be fast,
# e.g. qwen2.5-coder:3b (~1.9 GB). Gemini users can set a Gemini model name here.
CODE_MODEL=

# Gemini free tier: key from https://aistudio.google.com/apikey  (never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Port for `npm start` (production server)
PORT=8787
